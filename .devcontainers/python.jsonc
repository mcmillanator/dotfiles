{
  "name": "${localWorkspaceFolder}",
  "image": "mcmillanator/prebuilt-python:latest",
  "service": "app",
  "overrideCommand": true,
  "workspaceMount": "source=${localWorkspaceFolder},target=${localWorkspaceFolder},type=bind,consistency=cached",
  "workspaceFolder": "${localWorkspaceFolder}",
  "remoteUser": "${localEnv:USER}",
  "containerUser": "root",
  "updateRemoteUserUID": true,
  "mounts": [
    {
      "source": "${localEnv:HOME}/dotfiles",
      "target": "${localEnv:HOME}//dotfiles",
      "type": "bind",
      "consistency": "cached"
    },
    {
      "source": "${localEnv:HOME}/.aws",
      "target": "${localEnv:HOME}/.aws",
      "type": "bind",
      "consistency": "cached"
    },
    {
      "source": "dev_home",
      "target": "/home/${localEnv:USER}",
      "type": "volume",
      "consistency": "cached",
      "external": "true"
    },
    {
      "source": "${localEnv:HOME}/.oh-my-zsh/",
      "target": "${localEnv:HOME}/.oh-my-zsh/",
      "type": "bind",
      "consistency": "cached"
    },
    {
      "source": "${localEnv:HOME}/.ssh/",
      "target": "${localEnv:HOME}/.ssh/",
      "type": "bind",
      "consistency": "cached"
    },
    {
      "source": "${localEnv:HOME}/.gnupg/",
      "target": "${localEnv:HOME}/.gnupg/",
      "type": "bind",
      "consistency": "cached"
    },
    {
      "source": "${localEnv:TMUX_SOCKET_DIR}",
      "target": "${localEnv:TMUX_SOCKET_DIR}",
      "type": "bind",
      "consistency": "cached"
    }
  ],
  "features": {
    "ghcr.io/mcmillanator/devcontainers-features/create-remote-user:latest": {
      "version": "latest",
      "REMOTE_GID": "1000",
      "REMOTE_GROUP": "stan",
      "REMOTE_HOME": "/home/stan",
      "REMOTE_SHELL": "/usr/bin/zsh",
      "REMOTE_UID": "1000"
    },
    // "ghcr.io/devcontainers/features/common-utils:2": {
    //   "installZsh": true,
    //   "configureZshAsDefaultShell": true,
    //   "installOhMyZsh": true,
    //   "installOhMyZshConfig": false,
    //   "username": "${localEnv:USER}",
    //   "userUid": "1000",
    //   "userGid": "1000"
    // }
  }
}
