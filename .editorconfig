root = true

# Spaces by default everywhere (mirrors the init.lua indentation policy).
[*]
indent_style = space
indent_size = 2

# Tab-required exceptions: make recipes need literal tabs; gofmt indents with
# hard tabs. Add new entries here to mirror vim.g.tab_filetypes in init.lua.
[Makefile]
indent_style = tab

[*.mk]
indent_style = tab

[*.go]
indent_style = tab
